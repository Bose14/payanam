# ====================================================================
# RideSync Database & Server Configuration
# ====================================================================

# Active Database Driver: 'local-sqlite' or 'supabase-postgres'
DB_DRIVER=local-sqlite

# --------------------------------------------------------------------
# 1. Local SQLite Database (Active by default - Zero setup required)
# --------------------------------------------------------------------
SQLITE_DB_PATH=./server/ridesync.db
PORT=5000

# --------------------------------------------------------------------
# 2. Remote / Live Supabase & PostgreSQL (For future deployment)
# --------------------------------------------------------------------
# Supabase Project URL & Anon Public Key:
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# PostgreSQL Direct Connection String:
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:your_password@db.your-project-id.supabase.co:5432/postgres

# PostgreSQL Connection Credentials Breakdown:
DB_HOST=db.your-project-id.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_database_password
