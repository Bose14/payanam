{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": false
  },
  "include": [
    "packages/*/src",
    "apps/*/src"
  ],
  "exclude": [
    "node_modules",
    "**/dist"
  ]
}
