NODE_ENV=development
PORT=3001
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://user:password@localhost:5432/payanam
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-long
JWT_EXPIRY=24h
REFRESH_TOKEN_EXPIRY=7d
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173
GROQ_API_KEY=your-groq-api-key

# Phone sign-in (SMS). Leave Twilio blank in development: the code prints in the server log.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# OTP_DEV_MODE=true returns the code in the API response. Never set in production.
OTP_DEV_MODE=true
